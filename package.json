{
  "name": "too-many-claw",
  "version": "1.0.13",
  "description": "OpenClaw extension with 35 AI agents that collaborate via Discord",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tmc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');const f='dist/cli.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c)}\"",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node dist/scripts/postinstall.js || true"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["openclaw", "ai", "agents", "discord", "collaboration", "claude"],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llaa33219/too-many-claw.git"
  },
  "bugs": {
    "url": "https://github.com/llaa33219/too-many-claw/issues"
  },
  "homepage": "https://github.com/llaa33219/too-many-claw#readme",
  "dependencies": {
    "ws": "^8.17.0",
    "discord.js": "^14.15.3",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.23",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "tsup": "^8.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
